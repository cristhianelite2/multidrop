{
    "manifest_version": 3,
    "name": "Multidrop AliExpress Hunter",
    "version": "1.0.8",
    "description": "Captura fichas AE/CJ, envía borradores y extrae media al producto por SKU en Multidrop.",
    "action": {
        "default_title": "Multidrop Hunter",
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "permissions": [
        "storage",
        "activeTab",
        "scripting",
        "tabs"
    ],
    "host_permissions": [
        "https://*.aliexpress.com/*",
        "https://*.aliexpress.us/*",
        "https://*.aliexpress.ru/*",
        "https://*.cjdropshipping.com/*",
        "https://shop.ceballosleon.com/*"
    ],
    "optional_host_permissions": [
        "http://*/*",
        "https://*/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://*.aliexpress.com/*",
                "https://*.aliexpress.us/*",
                "https://*.aliexpress.ru/*",
                "https://*.cjdropshipping.com/*"
            ],
            "js": ["content.js"],
            "css": ["content.css"],
            "run_at": "document_idle"
        }
    ]
}
