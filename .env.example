APP_NAME=Multidrop
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Mexico_City
APP_URL=http://localhost/html/multidrop/public

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=multidrop
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=multidrop_

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@multidrop.local"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=

VITE_APP_NAME="${APP_NAME}"

AI_DEFAULT_PROVIDER=miia
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
MIIA_API_KEY=
MIIA_BASE_URL=https://ia.ceballosleon.com
MIIA_MODEL=auto

CJ_API_BASE=https://developers.cjdropshipping.com/api2.0/v1
CJ_EMAIL=
CJ_API_KEY=
CJ_ACCESS_TOKEN=
CJ_REFRESH_TOKEN=
CJ_MCP_BASE=https://developers.cjdropshipping.cn/mcp

PAYMENT_DEFAULT=mercadopago
PAYMENT_ENABLED=stripe,paypal,mercadopago
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_BROWSER_RENDERING=false

# Cloudflare Access (Zero Trust) — panel /admin
CLOUDFLARE_ACCESS_ENABLED=false
CLOUDFLARE_ACCESS_MODE=optional
CLOUDFLARE_ACCESS_TEAM_DOMAIN=
CLOUDFLARE_ACCESS_AUD=
CLOUDFLARE_ACCESS_VERIFY_JWT=true

# Superusuario inicial (seeder)
SUPERUSER_NAME="Super Admin"
SUPERUSER_EMAIL=admin@multidrop.local
SUPERUSER_PASSWORD=Multidrop!2026

# MCP de catálogo (stdio). No se usa en el frontend. Reservada para un endpoint HTTP interno futuro.
MCP_API_KEY=

# Marketing (Creatify + ffmpeg para limpiar metadata de videos)
CREATIFY_API_ID=
CREATIFY_API_KEY=
CREATIFY_BASE_URL=https://api.creatify.ai
FFMPEG_PATH=ffmpeg
MARKETING_MAX_VIDEO_MB=80
MULTIDROP_MAX_DAILY_AD_SPEND=50
# Webhook opcional (Madgicx, n8n, tu API): recibe el brief y puede devolver { advice: { summary, budget_daily, targets, moves[] } }
MARKETING_OPTIMIZER_WEBHOOK=
